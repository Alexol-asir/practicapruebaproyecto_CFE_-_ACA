global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/reglas/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090
        labels:
          nodo: master

  - job_name: node
    static_configs:
{% for nombre, ip in nodos.items() %}
      - targets:
          - {{ ip }}:{{ puerto_node_exporter }}
        labels:
          nodo: {{ nombre }}
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for nombre, ip in nodos.items() %}
      - targets:
          - {{ ip }}:{{ puerto_cadvisor }}
        labels:
          nodo: {{ nombre }}
{% endfor %}

  - job_name: hdfs
    metrics_path: /probe
    params:
      module:
        - default
      target:
        - http://{{ ip_master }}:{{ puerto_namenode_web }}/jmx?qry=Hadoop:service=NameNode,name=FSNamesystemState
    static_configs:
      - targets:
          - json-exporter:7979
        labels:
          nodo: master

  - job_name: spark_master
    metrics_path: /metrics/master/prometheus/
    fallback_scrape_protocol: PrometheusText0.0.4
    static_configs:
      - targets:
          - {{ ip_master }}:{{ puerto_spark_master_web }}
        labels:
          nodo: master

  - job_name: spark_workers
    metrics_path: /metrics/prometheus/
    fallback_scrape_protocol: PrometheusText0.0.4
    static_configs:
{% for nombre, ip in nodos.items() if nombre != 'master' %}
      - targets:
          - {{ ip }}:{{ puerto_spark_worker_web }}
        labels:
          nodo: {{ nombre }}
{% endfor %}
