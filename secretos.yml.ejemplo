---
# Plantilla de los secretos. NO poner aquí los valores reales.
# Copiar este archivo como secretos.yml (que no se sube al repo, está en el .gitignore)
# y poner en él los valores de verdad.

# Token del bot de Telegram (lo da @BotFather)
telegram_bot_token: "123456789:CAMBIAR_POR_EL_TOKEN_DEL_BOT"

# Número del grupo de Telegram al que llegan las alertas (negativo, sin comillas)
telegram_chat_id: -1001234567890

# Contraseña del usuario admin de Grafana
grafana_admin_password: "CAMBIAR"